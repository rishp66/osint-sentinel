# ═══════════════════════════════════════════════════════════════
# OSINT Sentinel — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Preferred: use Doppler to manage secrets (never write real keys here).
#   brew install dopplerhq/cli/doppler && doppler login
#   doppler setup            # links this dir to the osint-sentinel project
#   doppler secrets upload .env   # one-time import of existing keys
#   doppler run -- uvicorn main:app --reload --port 8000
#
# Fallback: copy this to .env and fill in your values (local dev only).

# ── LLM Provider (pick ONE) ──────────────────────────────────
# Options: "ollama" (free/local), "groq" (free API), "anthropic" (paid)
LLM_PROVIDER=ollama

# ── Option 1: Ollama (FREE — self-hosted) ────────────────────
# Install: https://ollama.ai → `ollama pull llama3.1:8b`
# For a remote VM, change this to http://<VM_IP>:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Good alternatives: mistral:7b, mixtral:8x7b, deepseek-r1:8b, qwen2.5:14b

# ── Option 2: Groq (FREE tier — no credit card) ─────────────
# Sign up: https://console.groq.com → copy API key
# Free: 30 req/min, 14,400 req/day — runs on custom LPU hardware (insanely fast)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Alternatives: llama-3.1-8b-instant (fastest), mixtral-8x7b-32768

# ── Option 3: Anthropic (PAID — fallback) ───────────────────
ANTHROPIC_API_KEY=

# ── Option 4: Lightning.ai (used for LLM synthesis & report) ─
LIGHTNING_API_KEY=

# ── OSINT Sources (all free tier) ────────────────────────────
# Core reputation / infrastructure
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=
IPINFO_TOKEN=

# Additional threat-intel sources
URLSCAN_API_KEY=
HYBRID_ANALYSIS_API_KEY=
ABUSECH_AUTH_KEY=                  # Shared key: ThreatFox, URLhaus, MalwareBazaar
PULSEDIVE_API_KEY=                 # Optional — anonymous calls also work

# No key needed: WHOIS, DNS, GreyNoise (community), RDAP, CIRCL CVE

# ── CVE MCP Server (optional — augments CIRCL CVE for CVE lookups) ──────
# 1. Clone https://github.com/mukul975/cve-mcp-server and install it:
#      git clone https://github.com/mukul975/cve-mcp-server.git ~/cve-mcp-server
#      cd ~/cve-mcp-server && python -m venv venv && source venv/bin/activate
#      pip install -e .
# 2. Set CVE_MCP_ENABLED=true and point CVE_MCP_WORKDIR at the repo root.
# 3. Sentinel will spawn the server via stdio (no inbound port is opened).
CVE_MCP_ENABLED=false
CVE_MCP_COMMAND=python                       # or full path to venv python
CVE_MCP_ARGS=-m cve_mcp.server               # space-separated; default is fine
CVE_MCP_WORKDIR=                             # abs path, e.g. /home/user/cve-mcp-server
CVE_MCP_TIMEOUT_SECONDS=20
# Keys forwarded into the MCP sub-process environment (all optional)
NVD_API_KEY=                                 # 10× NVD rate limit (free at nvd.nist.gov)
CVE_GITHUB_TOKEN=                            # GitHub GHSA / PoC search rate limit

# ── App Config ───────────────────────────────────────────────
CACHE_TTL_SECONDS=300
DEBUG=false
# When set, POST /scan requires this value as Authorization: Bearer <API_KEY>
# or X-API-Key. Leave empty for local-only / trusted networks.
API_KEY=

# ── Deployment ───────────────────────────────────────────────
# Comma-separated list of allowed browser origins (always enforced; DEBUG does
# not enable wildcard CORS). Example local dev defaults include localhost:5173.
# Example: CORS_ORIGINS=https://sentinel.example.com,https://www.sentinel.example.com
CORS_ORIGINS=

# Set to true ONLY when running behind a trusted reverse proxy
# (Cloudflare, nginx, Fly.io, Render, etc.) so the rate limiter reads
# the real client IP from X-Forwarded-For / X-Real-IP. Never enable this
# while the backend is exposed directly to the public internet — clients
# would be able to spoof their IP via the header.
TRUST_PROXY_HEADERS=false
