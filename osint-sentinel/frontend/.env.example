# ═══════════════════════════════════════════════════════════════
# OSINT Sentinel — Frontend Environment
# ═══════════════════════════════════════════════════════════════
# Copy to .env (local) or .env.production (build target) and fill in.

# Leave empty in local dev — Vite proxies /scan and /health to the
# backend running on http://127.0.0.1:8000 (see vite.config.js).
#
# In production, point the built frontend at your deployed API:
#   VITE_API_BASE_URL=https://api.sentinel.example.com
VITE_API_BASE_URL=
